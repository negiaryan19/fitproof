# Backend only. Copy this file to .env; never commit keys.
SERPAPI_KEY=
LLM_PROVIDER=gemini
LLM_API_KEY=
# Exact model ID available to your account. Required in live mode.
LLM_MODEL=
MAX_SEARCHES=12
MAX_FOLLOWUP_ROUNDS=2
MAX_OFFERS=5
SEARCH_CACHE_SECONDS=3600
ENABLE_REPLAY=true
CORS_ORIGINS=http://127.0.0.1:5177,http://localhost:5177

